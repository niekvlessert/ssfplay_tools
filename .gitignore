!/mednafen/src/hw_cpu/m68k/m68k.h
!/mednafen/src/hw_cpu/m68k/m68k_instr.inc
!/mednafen/src/resampler/
/mednafen/src/resampler/*
!/mednafen/src/resampler/arch.h
!/mednafen/src/resampler/fixed_generic.h
!/mednafen/src/resampler/resample.c
!/mednafen/src/resampler/resample_sse.h
!/mednafen/src/resampler/resampler.h
!/mednafen/src/resampler/stack_alloc.h
!/mednafen/src/string/
/mednafen/src/string/*
!/mednafen/src/string/string.cpp
!/mednafen/src/string/string.h
!/mednafen/src/trio/
/mednafen/src/trio/*
!/mednafen/src/trio/trio.c
!/mednafen/src/trio/trio.h
!/mednafen/src/trio/triodef.h
!/mednafen/src/trio/trionan.c
!/mednafen/src/trio/trionan.h
