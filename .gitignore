# Optional local validation dependency; ssfplay does not require libvgm to build.
/libvgm/

# Reduced Mednafen vendor subset. The project builds from a small SSF/SCSP
# slice; keep the full unpacked emulator tree local unless a file is allowlisted
# below.
/mednafen/*
!/mednafen/COPYING
!/mednafen/include/
/mednafen/include/*
!/mednafen/include/mednafen
!/mednafen/src/
/mednafen/src/*
!/mednafen/src/*.h
!/mednafen/src/error.cpp
!/mednafen/src/Stream.cpp
!/mednafen/src/MemoryStream.cpp
!/mednafen/src/FileStream.cpp
!/mednafen/src/VirtualFS.cpp
!/mednafen/src/PSFLoader.cpp
!/mednafen/src/SSFLoader.cpp
!/mednafen/src/win32-common.cpp
!/mednafen/src/compress/
/mednafen/src/compress/*
!/mednafen/src/compress/DecompressFilter.cpp
!/mednafen/src/compress/DecompressFilter.h
!/mednafen/src/compress/ZLInflateFilter.cpp
!/mednafen/src/compress/ZLInflateFilter.h
!/mednafen/src/hw_cpu/
/mednafen/src/hw_cpu/*
!/mednafen/src/hw_cpu/m68k/
/mednafen/src/hw_cpu/m68k/*
